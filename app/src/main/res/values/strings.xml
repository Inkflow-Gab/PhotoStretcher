<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Photo Stretcher</string>

    <!-- Home -->
    <string name="home_subtitle">Stretch one band of a photo. Everything above and below it stays exactly the same.</string>
    <string name="home_pick_photo">Pick Photo</string>
    <string name="home_step_1">Pick a photo from your gallery.</string>
    <string name="home_step_2">Tap the photo twice to mark a band with two lines.</string>
    <string name="home_step_3">Drag the lines, then stretch the band between them.</string>
    <string name="home_step_4">Save it as a new picture in Pictures/PhotoStretcher.</string>
    <string name="home_privacy">Works completely offline. No ads, no account, nothing leaves your phone.</string>

    <!-- Editor -->
    <string name="action_back">Back</string>
